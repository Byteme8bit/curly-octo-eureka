+    def _paper_mirror_live_would_block(
+        self,
+        intent,
+        route,
+        net_return_pct: float,
+        *,
+        holdings: dict[str, float] | None = None,
+        usd_prices: dict[str, float] | None = None,
+    ) -> str:
+        """Return a block reason when paper would not mirror to live."""
+        if not self._mirror_mode or not self.settings.paper_mirror_live_only:
+            return ""
+        if intent.is_defensive and intent.from_asset == "ETH" and intent.to_asset == "USD":
+            return "Paper mirror-live: defensive ETH→USD trims blocked on live"
+        live_ok, live_reason = check_live_route(
+            route,
+            self.settings.live_allowed_assets,
+            allow_triangular=self.settings.live_allow_triangular,
+            max_route_legs=self.settings.live_max_route_legs,
+        )
+        if not live_ok:
+            return f"Paper mirror-live: {live_reason}"
+        mirror_block = self._live_mirror_offensive_block(intent, route, net_return_pct)
+        if mirror_block:
+            return f"Paper mirror-live: {mirror_block}"
+        if (
+            holdings is not None
+            and usd_prices is not None
+            and self.live_broker is not None
+        ):
+            live_holdings = self._live_holdings()
+            live_constraints = self._live_constraints or self.constraints
+            required_edge = self._required_edge_for_intent(intent, route)
+            constraint = live_constraints.validate_intent(
+                intent,
+                live_holdings,
+                usd_prices,
+                required_edge=required_edge,
+            )
+            if not constraint.allowed:
+                return f"Paper mirror-live: {constraint.reason}"
+            route_check = live_constraints.check_route_eth_floor(
+                route, live_holdings, constraint.size_pct
+            )
+            if not route_check.allowed:
+                return f"Paper mirror-live: {route_check.reason}"
+        return ""
+
