+def _closed_loop_corrected_pnl(trade: dict) -> float | None:
+    """Recompute closed-loop edge when stored gain_loss is notional-scale (legacy bug)."""
+    hops = int(trade.get("hops") or 1)
+    from_a = trade.get("from_asset")
+    to_a = trade.get("to_asset")
+    if hops <= 1 or not from_a or from_a != to_a:
+        return None
+    start = float(trade.get("from_qty") or 0.0)
+    end = float(trade.get("to_qty") or 0.0)
+    if start <= 0:
+        return None
+    fees = float(trade.get("fee_usd") or trade.get("fee_quote") or 0.0)
+    if fees <= 0:
+        return None
+    # Approx compounded taker drag across hops → recover traded notional / unit price
+    fee_pct = max(0.001, 0.004 * hops)
+    notional = fees / fee_pct
+    px = notional / start
+    return (end - start) * px
+
+
+def _effective_trade_pnl(trade: dict) -> float:
+    stored = trade.get("gain_loss")
+    stored_f = float(stored) if stored is not None else None
+    corrected = _closed_loop_corrected_pnl(trade)
+    if corrected is None:
+        return stored_f or 0.0
+    if stored_f is None:
+        return corrected
+    # Legacy bug booked ~notional as gain; corrected edge is usually <$5 for paper sizes.
+    if abs(stored_f) > max(5.0, abs(corrected) * 5.0):
+        return corrected
+    return stored_f
+
