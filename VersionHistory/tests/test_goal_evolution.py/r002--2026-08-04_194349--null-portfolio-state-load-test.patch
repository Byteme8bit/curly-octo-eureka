+def test_goal_state_load_treats_null_portfolio_as_zero(tmp_path):
+    state_path = tmp_path / ".tradebot_goals_state.json"
+    state_path.write_text(
+        '{"achieved_tiers":[0],"crash_hold_active":false,'
+        '"session_start_portfolio":null,"last_portfolio_usd":null}',
+        encoding="utf-8",
+    )
+    state = GoalEvolutionState.load(state_path)
+    assert state.session_start_portfolio == 0.0
+    assert state.last_portfolio_usd == 0.0
+
